<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <ApplicationIcon>eye_icon.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <AssemblyTitle>EVE IntelPulse</AssemblyTitle>
    <Product>EVE IntelPulse</Product>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="eye_icon.ico" />
    <EmbeddedResource Include="eve_universe.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The manual-upload folder mirrors the repository contents; exclude it from the build. -->
    <Compile Remove="for-github/**" />
    <EmbeddedResource Remove="for-github/**" />
    <None Remove="for-github/**" />
  </ItemGroup>
</Project>